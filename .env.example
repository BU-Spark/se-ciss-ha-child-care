# PostgreSQL database. Use your real Railway URL in .env or Railway variables only.
DATABASE_URL="REPLACE_WITH_YOUR_POSTGRES_DATABASE_URL"

# Clerk authentication. Use real values in .env or hosting variables only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="REPLACE_WITH_YOUR_CLERK_SECRET_KEY"

# Optional: link your Clerk account to seeded staff users (re-run npm run db:seed after setting)
SEED_CCRR_CLERK_USER_ID=""
SEED_CCRR_SEVEN_HILLS_CLERK_USER_ID=""
SEED_CCRR_BOSTON_CLERK_USER_ID=""
SEED_EEC_CLERK_USER_ID=""
SEED_BOSTON_RESOURCE_CLERK_USER_ID=""
SEED_NORTHEAST_RESOURCE_CLERK_USER_ID=""
SEED_OMAR_EEC_CLERK_USER_ID=""
