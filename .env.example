# Copy to .env and fill in values before running locally or deploying.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Required. Use your hosted Postgres connection string (e.g. Railway).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/database"

# ─── Clerk authentication ─────────────────────────────────────────────────────
# Required. Create an application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Resend (optional — confirmation emails) ─────────────────────────────────
# Leave unset until a verified sending domain is configured.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="EEC Orientation <orientation@yourdomain.gov>"
# ORIENTATION_SLIDES_PATH="./public/files/orientation-slides.pdf"

# ─── Node ─────────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by the host (production on deploy).
