# ─── Database (Railway PostgreSQL) ───────────────────────────────────────────
# LOCAL: use the *.proxy.rlwy.net public URL
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"
DATABASE_PUBLIC_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"

# ─── Clerk authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Resend (Epic 1 confirmation email — not wired yet) ─────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="EEC Orientation <onboarding@yourdomain.com>"
# Optional: path to orientation slides PDF for email attachment
# ORIENTATION_SLIDES_PATH="./public/files/orientation-slides.pdf"

# ─── Test accounts ──────────────────────────────────────────────────────────
