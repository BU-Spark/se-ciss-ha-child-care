# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Secrets & local env (never commit) ───────────────────────────────────────
.env
.env.*
!.env.example

# ─── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ─────────────────────────────────────────────────
/.next/
/out/
/build
.turbo/

# ─── Testing ────────────────────────────────────────────────────────────────
/coverage

# ─── Database (local only) ─────────────────────────────────────────────────
/prisma/dev.db
/prisma/dev.db-journal

# ─── Auth / deployment tooling ──────────────────────────────────────────────
/.clerk/
.vercel
.railway

# ─── Logs & debug ───────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS & editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.pem

# ─── TypeScript ─────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
